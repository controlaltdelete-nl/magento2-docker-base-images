#!/bin/bash

set -e

echo "Stopping services..."
if [ "$ENABLE_VARNISH" = "true" ]; then
  /usr/bin/supervisorctl stop varnish
fi
if [ "$ENABLE_MAILPIT" = "true" ]; then
  /usr/bin/supervisorctl stop mailpit
fi
/usr/bin/supervisorctl stop elasticsearch
sleep 5
/usr/bin/supervisorctl shutdown

sleep 20
echo "Services stopped."

# Lucene leaves node.lock and write.lock files behind when Elasticsearch stops.
# Kept in the image they crash Elasticsearch on the first start of every container
# ("Underlying file changed by an external force"), so remove them here.
rm -fv /var/lib/elasticsearch/nodes/*/node.lock
find /var/lib/elasticsearch -name write.lock -print -delete
