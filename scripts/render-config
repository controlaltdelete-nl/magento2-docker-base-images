#!/bin/bash

# Renders nginx and php-fpm config from environment variables. start-services
# runs this on every invocation, both at image build time and at container
# boot, so every step in here must be idempotent.

set -e

[ "$DEBUG" == 'true' ] && set -x

NGINX_DOCROOT="${NGINX_DOCROOT:-/data}"
if [ "$NGINX_DOCROOT" != "/data" ]; then
  mkdir -p "$NGINX_DOCROOT"
  sed -i "s#root /data;#root ${NGINX_DOCROOT};#" /etc/nginx/conf.d/default.conf
fi

if [ "$ENABLE_VARNISH" = "true" ]; then
  sed -i 's/listen 80;/listen 8080;/' /etc/nginx/conf.d/default.conf
fi

if [ "$ENABLE_CORS" = "true" ]; then
  for conf in /etc/nginx/conf.d/*.conf /etc/nginx/available/magento.conf; do
    if ! grep -q 'include /etc/nginx/available/cors.conf;' "$conf"; then
      sed -i 's#server_name _;#server_name _;\n    include /etc/nginx/available/cors.conf;#' "$conf"
    fi
  done
fi

if [ -n "$PHP_FPM_MAX_CHILDREN" ]; then
  sed -i "s/^pm.max_children = .*/pm.max_children = ${PHP_FPM_MAX_CHILDREN}/" /etc/php/*/fpm/pool.d/zz-magento.conf
fi

if [ "$ENABLE_MAILPIT" = "true" ]; then
  for dir in /etc/php/*/fpm/conf.d /etc/php/*/cli/conf.d; do
    printf 'sendmail_path = "/usr/local/bin/mailpit sendmail -t -S 127.0.0.1:1025"\n' > "${dir}/zz-mailpit-sendmail.ini"
  done
fi
